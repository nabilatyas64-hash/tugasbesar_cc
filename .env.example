# Salin menjadi .env lalu isi nilainya. JANGAN commit .env
PORT=8000
BASE_URL=http://localhost:8000

# Untuk Docker Compose pakai DB_HOST=db dan REDIS_HOST=redis
# Untuk jalan lokal tanpa Docker pakai localhost
DB_HOST=db
DB_PORT=3306
DB_NAME=pendekin
DB_USER=pendekin
DB_PASSWORD=ganti_dengan_password_kuat

REDIS_HOST=redis
REDIS_PORT=6379
CACHE_TTL_SECONDS=3600
